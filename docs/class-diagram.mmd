        +run(params: dict) dict
    }
    
    %% === HeraUEBA Domain Models ===
    class User {
        +user_id: int
        +username: str
        +email: str
        +full_name: str
        +unit_id: int
        +role_id: int
        +active: bool
        +unit: Unit | None
        +role: Role | None
        +is_critical_user() bool
    }
    
    class Role {
        +role_id: int
        +role_name: str
        +description: str
        +has_permission(permission: str) bool
    }
    
    class Unit {
        +unit_id: int
        +unit_name: str
        +is_critical: bool
        +unit_type: str
    }
    
    class AuthEvent {
        +event_id: int
        +user_id: int | None
        +ip_address: str
        +geo_country: str
        +is_vpn: bool
        +outcome: str
        +event_timestamp: datetime
        +to_dict() dict
    }
    
    class Alert {
        +alert_id: int
        +event_id: int | None
        +user_id: int
        +severity: str
        +alert_status: str
        +model_type: str
        +risk_score: float
        +alert_timestamp: datetime
        +decision_paths: list[DecisionPath]
        +explain() str
        +is_critical() bool
    }
    
    class DecisionPath {
        +path_id: int
        +alert_id: int
        +node_index: int
        +split_feature: str
        +split_condition: str
        +split_value: str
        +rule_explanation: str
        +is_leaf: bool
        +to_human_readable() str
    }
    
    class WhitelistEntry {
        +whitelist_id: int
        +user_id: int
        +country: str
        +start_date: date
        +end_date: date
        +active: bool
        +is_valid_at(dt: datetime) bool
    }
    
    class QuarantineAction {
        +action_id: int
        +user_id: int
        +alert_id: int
        +action_status: str
        +requested_by: int
        +approved_by: int | None
        +two_step_confirmed: bool
        +simulated: bool
        +blocked_due_to_critical_unit: bool
        +can_execute() bool
        +execute() dict
    }
    
    class AuditLog {
        +log_id: int
        +actor_username: str
        +action_type: str
        +resource_type: str
        +resource_id: str
        +success: bool
        +created_at: datetime
        +log() void
    }
    
    %% === Inheritance ===
    BaseAgent <|-- ResearchAgent
    BaseAgent <|-- CodingAgent
    
    BaseSkill <|-- WebSearchSkill
    BaseSkill <|-- CodeExecutorSkill
    BaseSkill <|-- DbQuerySkill
    BaseSkill <|-- DocumentGeneratorSkill
    
    LLMProvider <|-- LocalLLMProvider
    LLMProvider <|-- OpenAILLMProvider
    LLMProvider <|-- AnthropicLLMProvider
    
    %% === Composition / Usage ===
    AgentRegistry *-- BaseAgent
    SkillRegistry *-- BaseSkill
    
    Router --> AgentRegistry
    Executor --> Planner
    Executor --> AgentRegistry
    Executor --> Logger
    Executor --> Tracer
    Executor --> Guardrails
    
    MemoryManager *-- ShortTermMemory
    MemoryManager *-- LongTermMemory
    MemoryManager --> Logger
    
    ProviderRouter *-- LLMProvider
    ProviderRouter --> CostTracker
    ProviderRouter --> Logger
    
    CostTracker --> Logger
    Permissions --> Logger
    Guardrails --> Logger
    Tracer --> Logger
    
    %% === Agent-Skill Relations ===
    ResearchAgent ..> WebSearchSkill : uses
    ResearchAgent ..> DocumentGeneratorSkill : uses
    CodingAgent ..> CodeExecutorSkill : uses
    
    %% === Domain Relations ===
    User "1" *-- "0..*" Alert : receives
    User "1" *-- "0..*" AuthEvent : generates
    User "1" *-- "0..*" WhitelistEntry : has_exceptions
    User "1" *-- "0..*" QuarantineAction : isolated
    User "0..*" -- "1" Unit : belongs_to
    User "0..*" -- "1" Role : has_role
    
    Alert "1" *-- "1..*" DecisionPath : explained_by
    Alert "0..1" -- "1" AuthEvent : originates
    Alert "1" *-- "0..*" QuarantineAction : motivates
    
    QuarantineAction "0..*" -- "1" User : requested_by
    QuarantineAction "0..*" -- "0..1" User : approved_by
    
    AuditLog "0..*" -- "0..1" User : actor
    
    %% === Notes ===
    note for BaseAgent "Contract: all agents inherit run(task) -> dict"
    note for MemoryManager "Single entry point; agents/skills don't access ST/LT directly"
    note for Guardrails "Enforces BR-001 (no auto-block) + policy checks"
    note for QuarantineAction "simulated flag enforces MVP scope; blocked_due_to_critical_unit for FR-007; two_step_confirmed for FR-006"
    note for DecisionPath "FR-004: white-box explainability (tree path nodes)"
    note for Permissions "RBAC aligned to NFR-003 (Analyst vs Coordinator)"
