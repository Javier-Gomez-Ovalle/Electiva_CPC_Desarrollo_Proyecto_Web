# ─────────────────────────────────────────────────────────────────────────────
# Estado local de herramientas (se regenera con el instalador de skills)
# ─────────────────────────────────────────────────────────────────────────────
.agents/
.opencode/

# ─────────────────────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ─────────────────────────────────────────────────────────────────────────────
# Node (verificación del prototipo: `npm install` en Stitch-prototype/)
# ─────────────────────────────────────────────────────────────────────────────
node_modules/
package-lock.json
npm-debug.log*
yarn-error.log*

# ─────────────────────────────────────────────────────────────────────────────
# Exportaciones rasterizadas de docs/ — regenerables desde .drawio / .mmd
#
# El alcance es deliberadamente `docs/` y no global: los PNG de
# Stitch-prototype/capturas/ y Stitch-prototype/designs/ SÍ se versionan,
# son el registro visual revisable del prototipo.
# ─────────────────────────────────────────────────────────────────────────────
docs/*.png
docs/*.svg

# ─────────────────────────────────────────────────────────────────────────────
# Secretos y configuración local
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

