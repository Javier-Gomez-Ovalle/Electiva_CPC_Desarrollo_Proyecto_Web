# ─────────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
*~
*.swp
*.swo
.idea/
.vscode/
*.sublime-workspace

